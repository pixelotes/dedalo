{
  "version": 1,
  "name": "wikipedia-diario",
  "nodes": [
    {
      "id": "fetch_wikipedia",
      "type": "input.http_call",
      "label": "Artículo aleatorio (API completa)",
      "config": {
        "url": "https://es.wikipedia.org/w/api.php?action=query&format=json&formatversion=2&prop=extracts|info&inprop=url&explaintext=1&generator=random&grnnamespace=0&grnlimit=1",
        "method": "GET",
        "engine": "auto",
        "impersonate": "chrome",
        "timeout": 15.0
      },
      "x": 80.0,
      "y": 140.0
    },
    {
      "id": "resumir_luhn",
      "type": "transform.summarize",
      "label": "Puntos clave (Luhn+)",
      "config": {
        "engine": "luhn+",
        "length": "long",
        "format": "bullets",
        "field": "query.pages.0.extract",
        "sentences": 8
      },
      "x": 380.0,
      "y": 140.0
    },
    {
      "id": "formatear_articulo",
      "type": "transform.template",
      "label": "Formatear informe",
      "config": {
        "fan_in": "all",
        "template": "# Artículo Diario de Wikipedia ({fecha})\n\n## {query.pages.0.title}\n- **Enlace:** {query.pages.0.canonicalurl}\n\n### Puntos Clave del Artículo (Luhn+):\n{entrada}\n"
      },
      "x": 680.0,
      "y": 140.0
    },
    {
      "id": "guardar_articulo",
      "type": "output.file",
      "label": "Guardar wikipedia-articulo-diario.md",
      "config": {
        "filename": "wikipedia-articulo-diario.md",
        "directory": "",
        "mode": "sobrescribir"
      },
      "x": 980.0,
      "y": 140.0
    }
  ],
  "edges": [
    {
      "source": "fetch_wikipedia",
      "target": "resumir_luhn",
      "port": "ok"
    },
    {
      "source": "resumir_luhn",
      "target": "formatear_articulo",
      "port": "ok"
    },
    {
      "source": "fetch_wikipedia",
      "target": "formatear_articulo",
      "port": "ok"
    },
    {
      "source": "formatear_articulo",
      "target": "guardar_articulo",
      "port": "ok"
    }
  ]
}