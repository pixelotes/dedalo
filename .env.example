# Configuración de Dédalo Standalone
DEDALO_PORT=8080
DEDALO_HOST=0.0.0.0
# Hosts permitidos en la cabecera Host (separados por comas; admite *.dominio y *).
# Por defecto solo localhost. Añade aquí tu dominio o IP de Tailscale.
# DEDALO_ALLOWED_HOSTS=localhost,127.0.0.1,dedalo.example.com

# Proveedor LLM (OpenAI compatible)
# Ejemplos:
# Ollama local: http://localhost:11434/v1
# llama.cpp server: http://localhost:8081/v1
# OpenRouter: https://openrouter.ai/api/v1
DEDALO_LLM_URL=http://localhost:11434/v1
DEDALO_LLM_MODEL=llama3
DEDALO_LLM_KEY=

# Telegram opcional para notificaciones globales
# DEDALO_TELEGRAM_TOKEN=123456:ABC-DEF
# DEDALO_TELEGRAM_CHAT_ID=123456789
