# Dédalo Standalone configuration
DEDALO_PORT=8080
DEDALO_HOST=0.0.0.0
# Language of messages for scheduled runs and webhooks: en | es
# DEDALO_LANG=en
# Hosts allowed in the Host header (comma-separated; supports *.domain and *).
# By default only localhost. Add your domain or Tailscale IP here.
# DEDALO_ALLOWED_HOSTS=localhost,127.0.0.1,dedalo.example.com

# Master key to encrypt secrets at rest (Fernet key). If not set, data/master.key is generated.
# Better to store it outside data/. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEDALO_MASTER_KEY=
# DEDALO_MASTER_KEY_FILE=/run/secrets/dedalo_master_key

# External secret stores: a secret may contain a reference such as op://Vault/Item/field or
# vault://secret/path#field instead of a value. Bootstrap credentials (never stored in data/):
# OP_SERVICE_ACCOUNT_TOKEN=            # 1Password service account (needs the `op` CLI)
# VAULT_ADDR=https://vault.example:8200
# VAULT_TOKEN=                         # or VAULT_TOKEN_FILE=/run/secrets/vault_token (BAO_* for OpenBao)
# How long resolved references are cached in memory, in seconds (0 disables the cache)
# DEDALO_SECRETS_CACHE_TTL=300
# Variables hidden from shell commands are re-exposed with e.g. DEDALO_ENV_ALLOW=VAULT_ADDR

# Shell command isolation with bubblewrap: off | auto | on (default: off in command nodes, auto in transform.coder)
# DEDALO_SANDBOX=auto
# DEDALO_SANDBOX_NET=deny
# DEDALO_SANDBOX_RO=/opt/tools
# DEDALO_SANDBOX_RW=/srv/work
# Extra environment variable patterns that subprocesses do not inherit (in addition to Dédalo's secrets)
# DEDALO_ENV_DENY=MY_TOKEN_*

# Optional token for /api/webhook/<flow> (Authorization: Bearer, X-Dedalo-Token o ?token=)
# DEDALO_WEBHOOK_TOKEN=
# Maximum request body size, in MB
# DEDALO_MAX_BODY_MB=25

# Scheduled flows that can run at the same time (1 = sequential, as before)
# DEDALO_MAX_CONCURRENT_FLOWS=2

# LLM provider (OpenAI compatible)
# Examples:
# Local Ollama: http://localhost:11434/v1
# llama.cpp server: http://localhost:8081/v1
# OpenRouter: https://openrouter.ai/api/v1
DEDALO_LLM_URL=http://localhost:11434/v1
DEDALO_LLM_MODEL=llama3
DEDALO_LLM_KEY=

# Optional Telegram for global notifications
# DEDALO_TELEGRAM_TOKEN=123456:ABC-DEF
# DEDALO_TELEGRAM_CHAT_ID=123456789
